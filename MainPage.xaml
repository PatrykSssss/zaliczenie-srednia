<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sredniaocen.MainPage"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <Label
                Text="Kalkulator Średniej Ocen"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center" />

            <Frame BackgroundColor="#1E1E1E" CornerRadius="25" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <Entry x:Name="Ocena1"
                           Placeholder="Ocena 1"
                           PlaceholderColor="Gray"
                           Keyboard="Numeric"
                           TextColor="White"
                           BackgroundColor="#2A2A2A"/>

                    <Entry x:Name="Ocena2"
                           Placeholder="Ocena 2"
                           PlaceholderColor="Gray"
                           Keyboard="Numeric"
                           TextColor="White"
                           BackgroundColor="#2A2A2A"/>

                    <Entry x:Name="Ocena3"
                           Placeholder="Ocena 3"
                           PlaceholderColor="Gray"
                           Keyboard="Numeric"
                           TextColor="White"
                           BackgroundColor="#2A2A2A"/>

                    <Entry x:Name="Ocena4"
                           Placeholder="Ocena 4"
                           PlaceholderColor="Gray"
                           Keyboard="Numeric"
                           TextColor="White"
                           BackgroundColor="#2A2A2A"/>

                    <Entry x:Name="Ocena5"
                           Placeholder="Ocena 5"
                           PlaceholderColor="Gray"
                           Keyboard="Numeric"
                           TextColor="White"
                           BackgroundColor="#2A2A2A"/>

                    <Button
                        Text="Oblicz Średnią"
                        Clicked="OnObliczClicked"
                        BackgroundColor="#6C63FF"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="60"
                        Margin="0,10,0,0"/>

                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="25" Padding="20">
                <VerticalStackLayout Spacing="5">
                    <Label
                        x:Name="WynikLabel"
                        Text="Średnia: --"
                        FontSize="24"
                        TextColor="#00E676"
                        HorizontalOptions="Center"/>

                    <Label
                        x:Name="StatusLabel"
                        Text=""
                        FontSize="20"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>